<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_restock_employee" model="res.groups.privilege">
        <field name="name">Bổ sung hàng — Nhân viên</field>
    </record>
    <record id="privilege_restock_manager" model="res.groups.privilege">
        <field name="name">Bổ sung hàng — Quản lý</field>
    </record>
    <record id="group_restock_employee" model="res.groups">
        <field name="name">Nhân viên kho</field>
        <field name="privilege_id" ref="privilege_restock_employee"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_restock_manager" model="res.groups">
        <field name="name">Quản lý bổ sung hàng</field>
        <field name="privilege_id" ref="privilege_restock_manager"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_restock_company" model="ir.access">
        <field name="name">Phiếu trong công ty được phép</field>
        <field name="model_id" ref="model_store_restock_request"/>
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_restock_employee" model="ir.access">
        <field name="name">Nhân viên xem phiếu của mình</field>
        <field name="model_id" ref="model_store_restock_request"/>
        <field name="group_id" ref="group_restock_employee"/>
        <field name="operation">cru</field>
        <field name="domain">[('requester_id', '=', user.id)]</field>
    </record>
    <record id="rule_restock_manager" model="ir.access">
        <field name="name">Quản lý xem phiếu cửa hàng</field>
        <field name="model_id" ref="model_store_restock_request"/>
        <field name="group_id" ref="group_restock_manager"/>
        <field name="operation">ru</field>
        <field name="domain">['|', ('requester_id', '=', user.id), ('state', '!=', 'draft')]</field>
    </record>
    <record id="access_restock_admin_delete" model="ir.access">
        <field name="name">Quản trị viên xóa phiếu</field>
        <field name="model_id" ref="model_store_restock_request"/>
        <field name="group_id" ref="base.group_system"/>
        <field name="operation">d</field>
    </record>
    <record id="access_restock_employee_delete" model="ir.access">
        <field name="name">Nhân viên xóa phiếu nháp và chờ duyệt của mình</field>
        <field name="model_id" ref="model_store_restock_request"/>
        <field name="group_id" ref="group_restock_employee"/>
        <field name="operation">d</field>
        <field name="domain">[('requester_id', '=', user.id), ('state', 'in', ['draft', 'submitted'])]</field>
    </record>
    <!-- Global restrictions cannot be overridden by additive product grants.
         System admins and users acting as restock managers retain their own
         native product permissions; this rule does not grant product access. -->
    <record id="rule_restock_employee_product_template_readonly" model="ir.access">
        <field name="name">Nhân viên siêu thị chỉ đọc danh mục sản phẩm</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="operation">cud</field>
        <field name="domain">[(0, '=', 1)] if user.has_group('store_restock.group_restock_employee') and not user.has_group('store_restock.group_restock_manager') and not user.has_group('base.group_system') else []</field>
    </record>
    <record id="rule_restock_employee_product_variant_readonly" model="ir.access">
        <field name="name">Nhân viên siêu thị chỉ đọc biến thể sản phẩm</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="operation">cud</field>
        <field name="domain">[(0, '=', 1)] if user.has_group('store_restock.group_restock_employee') and not user.has_group('store_restock.group_restock_manager') and not user.has_group('base.group_system') else []</field>
    </record>
</odoo>
