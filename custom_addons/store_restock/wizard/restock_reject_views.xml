<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_restock_reject_wizard_form" model="ir.ui.view">
        <field name="name">store.restock.reject.wizard.form</field>
        <field name="model">store.restock.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Từ chối yêu cầu">
                <group>
                    <field name="request_id"/>
                    <field name="rejection_reason" placeholder="Nhập lý do từ chối"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Xác nhận từ chối" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
